# --- Security (required) ---
API_TOKEN=change-me-to-a-long-random-string

# --- Sending safety ---
# While TEST_RECIPIENT is set, EVERY email goes there instead of the real contact.
TEST_RECIPIENT=you@example.com
# Real recipients need TEST_RECIPIENT empty AND LIVE_SENDING=true.
LIVE_SENDING=false
DAILY_SEND_CAP=20
# Reply handling actions (slot proposals, bookings, CRM logs) run without a click only if true.
AUTOPILOT=false
SILENT_AFTER_DAYS=5

# --- Sender identity ---
SENDER_NAME=Your Name
SENDER_COMPANY=Sprinto

# --- Force every service to its offline mock ---
OFFLINE=false

# --- External services (each falls back to an offline mock when blank) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
HUNTER_API_KEY=
# Gmail: use an App Password (Google Account > Security > App passwords)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Cal.com (calendar + booking)
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
# HubSpot private-app token (CRM)
HUBSPOT_TOKEN=

CALENDAR_TZ=Asia/Kolkata
CALENDAR_UTC_OFFSET_MINUTES=330

# Gemini (used instead of Anthropic when set); comma-separated fallback chain is optional
GEMINI_API_KEY=
GEMINI_MODELS=
# Resend (used instead of Gmail for sending when set). Without a verified domain,
# onboarding@resend.dev can only send to the Resend account's own email.
RESEND_API_KEY=
RESEND_FROM=Your Name <onboarding@resend.dev>
REPLY_TO=
# Deployed only: Supabase Storage keeps the app data; ALLOWED_HOSTS = your deployed hostname
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_HOSTS=
